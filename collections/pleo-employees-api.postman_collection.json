    {
      "id": "445e8557-fed4-492f-a0b5-668356a2e0af",
      "name": "Employees",
      "description": {
        "content": "The Employees API enables you to search for employee records that\nare managed in Pleo. You can perform the following: \n - Search for multiple\nemployees \n - Search for a specific employee record by employee ID",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7216efe5-9e1f-4235-8737-6c6aa25638f2",
          "name": "Search for employees",
          "request": {
            "name": "Search for employees",
            "description": {
              "content": "Use this endpoint to search for multiple employees.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "employees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "companyId",
                  "value": "<uuid>",
                  "description": "Enter the company ID of the employees you are searching for. This is not a mandatory parameter; hence, if you do not know the company ID, the response message contains details of all employees to which you have access. If you are searching for employees at the organisation level, ensure that the access token used for authentication has the correct permissions."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "The email of the Employee you are searching for."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "The external ID of the Employee you are searching for."
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<string>",
                  "description": "Lower bound of the page of data to return (cannot be used together with [after] or [offset])."
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Upper bound of the page of data to return (cannot be used together with [before] or [offset])."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<long>",
                  "description": "Offset of the page of data to return (cannot be used together with [before] or [after])."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The maximum amount of items to return."
                },
                {
                  "disabled": false,
                  "key": "sorting_keys",
                  "value": "<string>",
                  "description": "The keys to sort the results by."
