      "item": [
        {
          "id": "79d78084-b081-4322-8f94-a28f45ec13e9",
          "name": "Enrich Accounting Entry V2",
          "request": {
            "name": "Enrich Accounting Entry V2",
            "description": {
              "content": "Enriches an existing Pleo card accounting entry by attaching one or more receipts and applying optional cost categorisation tags. Pleo identifies the matching entry using the transaction details provided as query parameters. Use this endpoint for all new implementations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounting-entries:enrich"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "Email address of the Pleo user who made the purchase. Used as an optional matching parameter."
                },
                {
                  "disabled": false,
                  "key": "performed_at",
                  "value": "<string>",
                  "description": "ISO 8601 timestamp of when the purchase was authorised (i.e. when the transaction happened). Either `performed_at` or `settled_at` must be provided."
                },
                {
                  "disabled": false,
                  "key": "settled_at",
                  "value": "<string>",
                  "description": "ISO 8601 timestamp of when the purchase was settled (i.e. when the funds were transferred). Either `performed_at` or `settled_at` must be provided."
                },
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "<long>",
                  "description": "(Required) Transaction amount in minor units (e.g. 1500 represents €15.00)."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "(Required) ISO 4217 currency code of the transaction (e.g. EUR, GBP, DKK)."
                },
                {
                  "disabled": false,
                  "key": "card_last_four_digits",
                  "value": "<string>",
                  "description": "(Required) Last four digits of the Pleo card used for the transaction. Used as a matching parameter to identify the correct accounting entry."
                },
                {
                  "disabled": false,
                  "key": "merchant_name",
                  "value": "<string>",
                  "description": "(Required) Name of the merchant as it appears on the transaction."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receipts\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"tags\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
