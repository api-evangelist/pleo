  "item": [
    {
      "id": "e1848470-503c-471b-b3d8-675dd4104887",
      "name": "Installations",
      "description": {
        "content": "Installations of applications. An installation is a representation of an application being installed for a resource. Currently we support companies and organizations, future support might include users or teams. <br> Installations are created automatically after a successful OAuth flow. <br> The main use case for these APIs is to enable third party apps to manage their own installations and to get information about the installations that exist for a specific resource.",
        "type": "text/plain"
      },
